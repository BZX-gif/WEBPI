# WEBPI environment
# Copy this file to .env.local and fill in the values you have.
# Never commit real secrets.

# Public site URL used for canonical links, sitemap and Open Graph.
# Example: https://webpi.in
NEXT_PUBLIC_SITE_URL=

# Optional public contact details. Leave empty to hide from the website.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP=

# Optional social profile URLs. Leave empty to hide the links.
NEXT_PUBLIC_INSTAGRAM=
NEXT_PUBLIC_LINKEDIN=
NEXT_PUBLIC_X=
NEXT_PUBLIC_DRIBBBLE=
NEXT_PUBLIC_BEHANCE=
NEXT_PUBLIC_GITHUB=

# Enquiry delivery
# Resend free tier: https://resend.com
# Required in production so enquiries arrive by email.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=

# Optional analytics (only loaded when set)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
